# HoloDesk - API Keys Template
# Copy this file to .env and fill in your real keys.
# Never commit .env to git.

# Groq API - free at console.groq.com - used for chat + morning briefing
GROQ_API_KEY=gsk_your_groq_key_here

# OpenAI API - platform.openai.com - used for GPT-4o screen vision + ChatGPT tool
# $0.002 per screen read. $10 credit lasts a long time.
OPENAI_API_KEY=sk-proj-your_openai_key_here

# Anthropic API - console.anthropic.com - BrainAgent (commands the fixed router can't match).
# Without it HoloDesk falls back to the old chat path.
ANTHROPIC_API_KEY=
HOLODESK_BRAIN_MODEL=claude-sonnet-5

# 0 skips the OpenAI planner hop before the Brain (recommended once ANTHROPIC_API_KEY is set).
HOLODESK_OPENAI_PLANNER_ENABLED=0

# Wake word (optional)
# 0 = disabled (default, preserves current behavior)
HOLODESK_WAKE_WORD_ENABLED=0

# Phrase HoloDesk listens for when wake word is enabled
HOLODESK_WAKE_WORD_PHRASE=hey holo

# Engine options: simple | whisper | porcupine
HOLODESK_WAKE_WORD_ENGINE=simple

# Optional tuning for wake listener (does not affect existing voice tuning)
HOLODESK_WAKE_WORD_LISTEN_TIMEOUT=1.0
HOLODESK_WAKE_WORD_PHRASE_LIMIT=2.0
HOLODESK_WAKE_WORD_COOLDOWN=2.0

# Optional real OmniParser server. If unset, HoloDesk uses OpenAI Vision for
# live UI grounding when OPENAI_API_KEY is available, otherwise mock dry-runs.
# OMNIPARSER_SERVER_URL=http://127.0.0.1:8000
HOLODESK_UI_VISION_MODEL=gpt-4o
HOLODESK_WAKE_WORD_WHISPER_MODEL=tiny

# Only needed if HOLODESK_WAKE_WORD_ENGINE=porcupine
HOLODESK_PORCUPINE_ACCESS_KEY=

# Real browser automation (Playwright) for Gmail/Facebook/Instagram send flows.
# 0 = disabled (default). Requires `pip install playwright && playwright install chromium`.
HOLODESK_BROWSER_AUTOMATION_ENABLED=0

# Separate Chrome user-data folder HoloDesk launches with remote debugging. Must not be
# your normal Chrome data dir (Chrome 136+ blocks debugging there).
HOLODESK_BROWSER_PROFILE_DIR=%LOCALAPPDATA%\HoloDesk\chrome-profile

# Remote debugging port used to attach Playwright to the automation Chrome profile.
HOLODESK_BROWSER_DEBUG_PORT=9222

# ElevateU (study-helper backend). Local: run `uvicorn main:app --port 8000` in study-helper/backend
# with ALLOW_DEV_AUTH=true and DEV_USER_ID=<your Supabase user id>, then keep ELEVATEU_TOKEN=dev-token.
ELEVATEU_API_BASE=http://127.0.0.1:8000
ELEVATEU_TOKEN=dev-token

# Resume file the application filler uploads to "Resume/CV" fields (optional).
HOLODESK_RESUME_PATH=

# Speech recognition. base is ~3x faster than small on this laptop with the same text
# on clear English; use small (or medium) if Nepali or accented speech is misheard.
HOLODESK_WHISPER_MODEL=base
# auto lets Whisper detect Nepali vs English; set to en to pin English.
HOLODESK_STT_LANGUAGE=auto

# Speech engine: groq (hosted Whisper large v3, ~0.3 s, best accuracy, audio leaves
# this machine) or local (offline, uses HOLODESK_WHISPER_MODEL, ~8 s for small here).
HOLODESK_STT_ENGINE=groq
HOLODESK_GROQ_STT_MODEL=whisper-large-v3
