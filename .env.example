# HoloDesk — API Keys Template
# Copy this file to .env and fill in your real keys.
# Never commit .env to git.

# Groq API — free at console.groq.com — used for chat + morning briefing
GROQ_API_KEY=gsk_your_groq_key_here

# OpenAI API — platform.openai.com — used for GPT-4o screen vision + ChatGPT tool
# $0.002 per screen read. $10 credit lasts a long time.
OPENAI_API_KEY=sk-proj-your_openai_key_here

# ============================================================
# Brain v3 — everything below is optional except GROQ_API_KEY above
# ============================================================

# --- Phone control (Telegram) ---
# 1. In Telegram, message @BotFather, send /newbot, copy the token here.
# 2. Start run_daemon.py, message your bot once: it replies with your user ID.
# 3. Put that ID below and restart. Only these IDs can control the laptop.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# --- Who you are ---
HOLODESK_USER_NAME=

# --- Models (leave blank to auto-pick from what your provider serves) ---
# HOLODESK_CHAT_MODEL=openai/gpt-oss-120b
# HOLODESK_FAST_MODEL=openai/gpt-oss-20b
# HOLODESK_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Run fully local later (needs a GPU or a lot of patience):
# HOLODESK_LLM_BASE_URL=http://localhost:11434/v1

# --- Speech ---
# auto = detect each utterance; ne = always Nepali; en = always English
HOLODESK_STT_LANGUAGE=auto
# 1 = send commands to hosted Whisper large-v3; 0 = local Whisper only (English)
HOLODESK_CLOUD_STT=1
# ne-NP-SagarNeural (male) or ne-NP-HemkalaNeural (female)
HOLODESK_TTS_VOICE_NE=ne-NP-SagarNeural

# --- Switches ---
# 0 = turn the brain off and use the old regex router
HOLODESK_BRAIN=1
# Extra folders the file tools may touch, separated by ; (home folder is always allowed)
# HOLODESK_FILE_ROOTS=D:\Projects
